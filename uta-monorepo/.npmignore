# Exclude source files from the published npm package.
# Only the contents of `dist/` are shipped (configured via `files` in package.json).

# Source TypeScript — not needed at runtime
*.ts
!dist/**/*.ts

# Tests + benchmarks + smoke tests
packages/conformance/
scripts/

# Build artifacts (regenerated by consumers)
dist/tsconfig.tsbuildinfo

# Repository metadata
.github/
.gitignore
.npmignore
typedoc.json
tsconfig.json

# Documentation (kept as README.md, but TypeDoc output excluded)
dist/docs/
dist/benchmarks.json
dist/**/sbom.spdx.json
