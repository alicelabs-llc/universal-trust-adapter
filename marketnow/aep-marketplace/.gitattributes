# .gitattributes — force consistent line endings across all platforms
# This prevents the byte-identical mismatch that @anp2network found between
# NPM packages (CRLF line endings + BOM) and GitHub source (LF line endings).

# Auto-detect text vs binary files
* text=auto eol=lf

# Force LF for source files (never CRLF, even on Windows)
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.py    text eol=lf
*.go    text eol=lf
*.rs    text eol=lf
*.rb    text eol=lf
*.php   text eol=lf
*.java  text eol=lf
*.kt    text eol=lf
*.swift text eol=lf

# Force LF for data files
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf
*.csv   text eol=lf
*.svg   text eol=lf

# Force LF for docs
*.md    text eol=lf
*.txt   text eol=lf
*.rst   text eol=lf

# Force LF for shell scripts (must NOT have BOM)
*.sh    text eol=lf
*.bash  text eol=lf
*.zsh   text eol=lf
*.fish  text eol=lf

# Force LF for config files
*.env       text eol=lf
*.env.local text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf

# Force LF for web files
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.less  text eol=lf

# Binary files — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.tgz   binary
*.tar.gz binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.a     binary
*.o     binary
*.wasm  binary
*.spdx.json binary
*.sig   binary
*.pem   binary
*.key   binary
*.pub   binary
*.crt   binary
*.cer   binary
*.der   binary
*.p12   binary
*.pfx   binary

# Special: package.json MUST be LF (no BOM, no CRLF)
# This was the worst offender in @anp2network's verification
package.json    text eol=lf -text=bom

# Lockfiles
package-lock.json   text eol=lf
yarn.lock           text eol=lf
pnpm-lock.yaml      text eol=lf
poetry.lock         text eol=lf
Cargo.lock          text eol=lf
go.sum              text eol=lf

# Generated files — ignored
node_modules/**  binary
dist/**          binary
build/**         binary
.next/**         binary
.nuxt/**         binary
coverage/**      binary
*.min.js         binary
*.min.css        binary
*.map            binary

# Secrets — never normalize, never diff, never merge
.env            binary
.env.*          binary
.vercel-token   binary
.npm-token      binary
*.pem           binary
*.key           binary
secrets/**      binary
