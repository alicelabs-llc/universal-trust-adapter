{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/skills.json",
      "destination": "/api/skills?_mode=manifest"
    },
    {
      "source": "/api/stats.json",
      "destination": "/api/skills?_mode=stats"
    },
    {
      "source": "/(.*\\.sh)",
      "destination": "/api/skills?_mode=notfound"
    },
    {
      "source": "/api/community",
      "destination": "/api/certification?_mode=community"
    },
    {
      "source": "/api/badge",
      "destination": "/api/skill?_mode=badge"
    },
    {
      "source": "/mcps",
      "destination": "/mcps.html"
    },
    {
      "source": "/api/trust-score",
      "destination": "/api/skill?_mode=trust-score"
    },
    {
      "source": "/api/interceptor",
      "destination": "/api/trust?_mode=interceptor"
    },
    {
      "source": "/api/skills/:id",
      "destination": "/api/skill?_mode=json&slug=:id"
    },
    {
      "source": "/api/recommend",
      "destination": "/api/skills?_mode=recommend"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/skill?slug=:slug"
    },
    {
      "source": "/api/badge/:slug",
      "destination": "/api/skill?slug=:slug&_mode=badge"
    },
    {
      "source": "/api/submit-skill",
      "destination": "/api/skills?_mode=submit"
    },
    {
      "source": "/api/referrals",
      "destination": "/api/atc"
    },
    {
      "source": "/api/security",
      "destination": "/api/skills?_mode=security"
    },
    {
      "source": "/api/quarantine",
      "destination": "/api/skills?_mode=security&view=quarantine"
    },
    {
      "source": "/api/honeypot",
      "destination": "/api/skills?_mode=security&view=honeypot"
    },
    {
      "source": "/api/threat-intel",
      "destination": "/api/skills?_mode=security&view=threat-intel"
    },
    {
      "source": "/api/agent-analytics",
      "destination": "/api/skills?_mode=security&view=analytics"
    },
    {
      "source": "/security/sentinel-v3.0",
      "destination": "/security/sentinel-v3.0.html"
    },
    {
      "source": "/security/evidence",
      "destination": "/security/evidence.html"
    },
    {
      "source": "/security/sentinel-benchmark",
      "destination": "/security/sentinel-benchmark.html"
    },
    {
      "source": "/security/audit-2026-08-19",
      "destination": "/security/audit-2026-08-19.html"
    },
    {
      "source": "/((?!api/|uta/|trust/|policies/|security/|for-agents|landing-pages/|tools/|acp|atc|status|\\.well-known/).*)",
      "destination": "/index.html"
    },
    {
      "source": "/for-agents",
      "destination": "/for-agents.html"
    },
    {
      "source": "/acp",
      "destination": "/atc"
    },
    {
      "source": "/atc",
      "destination": "/atc/index.html"
    },
    {
      "source": "/atc/",
      "destination": "/atc/index.html"
    },
    {
      "source": "/atc/playground",
      "destination": "/atc/playground.html"
    },
    {
      "source": "/atc/spec",
      "destination": "/atc/spec/SPEC.md"
    },
    {
      "source": "/atc/conformance",
      "destination": "/atc/spec/CONFORMANCE.md"
    },
    {
      "source": "/atc/prior-art",
      "destination": "/atc/spec/PRIOR-ART-TIMELINE.md"
    },
    {
      "source": "/atc/schema",
      "destination": "/atc/spec/atc-1.0.json"
    },
    {
      "source": "/atc/sdk-readme",
      "destination": "/atc/spec/SDK-README.md"
    },
    {
      "source": "/atc/mcp-audit",
      "destination": "/atc/spec/MCP-AUDIT.md"
    },
    {
      "source": "/atc/verification-log",
      "destination": "/atc/spec/VERIFICATION-LOG.md"
    },
    {
      "source": "/badges/atc-compatible.svg",
      "destination": "/badges/atc-compatible.svg"
    },
    {
      "source": "/badges/atc-verified.svg",
      "destination": "/badges/atc-verified.svg"
    },
    {
      "source": "/best-mcp-marketplace",
      "destination": "/best-mcp-marketplace.html"
    },
    {
      "source": "/guides/how-to-publish-mcp-server",
      "destination": "/guides/how-to-publish-mcp-server.html"
    },
    {
      "source": "/guides/how-to-monetize-mcp-tools",
      "destination": "/guides/how-to-monetize-mcp-tools.html"
    },
    {
      "source": "/api/submit",
      "destination": "/api/skills?_mode=submit"
    },
    {
      "source": "/api/submissions",
      "destination": "/api/skills?_mode=queue"
    },
    {
      "source": "/atc/schema-3.0",
      "destination": "/atc/spec/atc-3.0.json"
    },
    {
      "source": "/atc/schema-1.4",
      "destination": "/atc/spec/atc-1.4-uvp.json"
    },
    {
      "source": "/atc/unified",
      "destination": "/atc/spec/SPEC-3.0-UVP.md"
    },
    {
      "source": "/licensing",
      "destination": "/licensing/index.html"
    },
    {
      "source": "/security/incidents/2026-09-08",
      "destination": "/security/incidents/2026-09-08/index.html"
    },
    {
      "source": "/api/search",
      "destination": "/api/skills"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.json"
    },
    {
      "source": "/api/manifest",
      "destination": "/api/manifest.json"
    },
    {
      "source": "/api/changelog",
      "destination": "/changelog.json"
    },
    {
      "source": "/api/mandates",
      "destination": "/api/skills?_mode=commerce"
    },
    {
      "source": "/api/agent-purchase",
      "destination": "/api/skills?_mode=commerce"
    },
    {
      "source": "/api/create-checkout-session",
      "destination": "/api/skills?_mode=commerce"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/skills?_mode=commerce"
    },
    {
      "source": "/api/verify-purchase",
      "destination": "/api/skills?_mode=commerce"
    },
    {
      "source": "/api/acp",
      "destination": "/api/skills?_mode=planned"
    },
    {
      "source": "/api/agent-register",
      "destination": "/api/skills?_mode=planned"
    },
    {
      "source": "/api/ai-match",
      "destination": "/api/skills?_mode=planned"
    },
    {
      "source": "/api/compare",
      "destination": "/api/skills?_mode=planned"
    },
    {
      "source": "/api/agent-wallet",
      "destination": "/api/agent-wallet.json"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, no-cache, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/uta/",
      "destination": "/uta",
      "permanent": false
    }
  ]
}
