# Normalize line endings to LF in the repo
* text=auto eol=lf

# Force LF for source files
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.go text eol=lf
*.rb text eol=lf
*.java text eol=lf
*.cs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Force CRLF for Windows-only files
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.zip binary
*.tgz binary
*.gz binary
